SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_COLLAB_URL=
COLLAB_JWT_SECRET=
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
# Remetente dos e-mails. Vazio usa o remetente de teste da Resend, que só entrega para o
# e-mail dono da conta. Com domínio verificado: Lugh <sessoes@seudominio>
EMAIL_FROM=
# Base dos links nos e-mails. Vazio usa o domínio de produção da Vercel ou o localhost.
APP_URL=
# Execução de código na sala (Judge0). Só a chave: usa o Judge0 CE do RapidAPI.
# JUDGE0_URL é só para instância própria. Sem nenhuma das duas, o Executar avisa que
# não está configurado.
JUDGE0_API_KEY=
JUDGE0_URL=
# "true" abre a sala a qualquer momento antes do fim da sessão (teste e demo). Deixar
# vazio fora da demo: ligada, dá para iniciar e encerrar uma sessão dias antes do horário.
ROOM_ALLOW_EARLY_ENTRY=
